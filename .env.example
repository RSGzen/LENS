# LENS environment template — copy to `.env` (gitignored) and fill in.
#
# Nothing here is committed with a real value. `lens/config.py` loads this file at
# import, so every setting below is also overridable as a normal env var.
#
# Path portability (M8.0): code paths are derived from the checkout; **runtime
# data** comes from ONE root. On a fresh machine the default is the platform data
# dir (`%LOCALAPPDATA%\lens`, or `~/.local/share/lens`); set LENS_DATA_ROOT to keep
# an existing tree (e.g. a big pre-built runs/cache directory) in place.
# LENS_DATA_ROOT=D:\lens-data

# --- secrets (never commit these) -------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
LENS_DB_PASSWORD=...
LENS_DB_RO_PASSWORD=...

# --- database (host port; native PostgreSQL owns 5432, so the container is 5433)
LENS_DB_HOST=localhost
LENS_DB_PORT=5433
LENS_DB_NAME=lens
LENS_DB_USER=lens
LENS_DB_RO_USER=lens_ro

# --- corpus inputs ----------------------------------------------------------
# Everything defaults to LENS_DATA_ROOT/corpus/{xml,pdf,metadata.jsonl}, which is
# where `scripts/fetch_corpus.py` writes. Set the variables below only to point at
# a corpus that already exists somewhere else (another drive, a shared folder).
#
# The metadata dump is one JSON object per line, from
# https://www.kaggle.com/datasets/Cornell-University/arxiv
#   LENS_ARXIV_METADATA=D:\corpus\metadata.jsonl
# Directory of GROBID output (<arxiv_id><version>.tei.xml); a load refuses to start
# when it holds no *.tei.xml.
#   LENS_GROBID_XML_DIR=D:\corpus\xml
# Where PDFs are downloaded and kept until they are converted (then deleted).
#   LENS_PDF_DIR=D:\corpus\pdf
# One root that moves all three at once; a specific variable above still wins.
#   LENS_CORPUS_DIR=D:\corpus

# --- optional path overrides (rarely needed: all derive from LENS_DATA_ROOT) ---
# LENS_RUNS_ROOT=D:\lens-data\runs
# LENS_LOGS_ROOT=D:\lens-data\logs
# LENS_MANIFESTS_ROOT=D:\lens-data\manifests
# LENS_CACHE_ROOT=D:\lens-data\cache
# LENS_SANDBOX_COMPOSE_FILE=D:\lens\docker-compose.yaml

# --- harness caps (defaults are fine for a first run) ------------------------
# LENS_MAX_ITERATIONS=8
# LENS_MAX_TOKENS=300000
# LENS_MAX_COST_USD=1.00   # raised 0.50 -> 1.00 (LOG-120): the Tier-1 anchor spent
#                          # $0.436 in 8 iterations (87 % of 0.50), so cost was about
#                          # to bind instead of iterations/tokens. $1.00 is the max that
#                          # matters at the 300k token cap (~$0.93 blended).
# LENS_MAX_EXEC_BLOCK_S=120
# LENS_MAX_BACKTRACKS=3
# LENS_CONTEXT_TOKEN_LIMIT=40000
# LENS_CONTEXT_COMPACT_RATIO=0.75
# LENS_ROOT_MAX_OUTPUT_TOKENS=8000
# LENS_SANDBOX_STDOUT_MAX_CHARS=6000

# --- run mode ---------------------------------------------------------------
# LENS_RECORDED=1     # disable dev-only escape hatches (T3 SQL) for a recorded run
# LENS_ALLOW_SQL=0    # T3 query(sql), dev only; forced off when recorded
# LENS_GATE=1         # 0 = decision-layer-OFF arm of the M11 ablation
# LENS_STAGE_THRESHOLDS=retrieval=0.72,kg=0.65   # calibrated tau_pass per stage;
#                     # empty (default) means tier 1 is skipped, not that it passes
# LENS_KG_ENABLED=1   # KG on/off ablation

# --- model overrides (M9) ----------------------------------------------------
# A plumbing run does not need the Tier-1 instrument. The id is recorded per call
# and in the manifest's arm block, so an override stays attributable (E-04).
# LENS_ROOT_MODEL=openai/gpt-5-mini
# LENS_SUB_MODEL=openai/gpt-5-mini
# LENS_DEV_MODEL=qwen/qwen3-coder

# --- RPC / sandbox ----------------------------------------------------------
# The sandbox is on an `internal: true` network and has no route to the host, so
# it dials `lens-relay`, which forwards one port to the host RPC server (LOG-114).
# LENS_HOST_RPC_PORT=8765
# LENS_RELAY_PORT=8090
# LENS_RELAY_TARGET_HOST=host.docker.internal
# LENS_SANDBOX_PORT=8080
# LENS_SANDBOX_IMAGE=lens-repl:0.1.0
# LENS_SANDBOX_DIGEST=sha256:...   # recorded in the manifest (E-04); run_campaign sets it
